{
 "$comment": "Strategy card schema (ARCHITECTURE.md section 6, strategies/schema.json; Pr13). Validated by harness/run_card.py with a built-in subset validator (type, required, properties, additionalProperties, items, enum, minItems, minimum).",
 "type": "object",
 "required": ["name", "role", "steps", "operator_choices", "applies_to"],
 "additionalProperties": false,
 "properties": {
  "name": {"type": "string"},
  "version": {"type": "integer", "minimum": 1},
  "description": {"type": "string"},
  "role": {"type": "string", "enum": ["generate", "transform"]},
  "view": {"type": "string", "enum": ["canonical", "shuffled", "low_prior"]},
  "data_style": {"type": "string", "enum": ["compact", "python"]},
  "operator_choices": {"type": "array", "minItems": 1,
   "items": {"type": "string", "enum": ["none", "drop", "negate", "vary", "oppose", "fix", "specialize", "recurse"]}},
  "applies_to": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["arc", "bt"]}},
  "steps": {"type": "array", "minItems": 1, "items": {
   "type": "object",
   "required": ["id", "template", "inputs"],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string"},
    "template": {"type": "string"},
    "inputs": {"type": "array", "items": {"type": "string",
     "enum": ["goal", "facts", "resources", "constraints", "operator", "seed", "parent", "feedback", "format", "transformed"]}},
    "max_tokens": {"type": ["integer", "null"], "minimum": 1},
    "n": {"type": ["integer", "null"], "minimum": 1},
    "role": {"type": "string", "enum": ["generate", "transform"]},
    "parser": {"type": "string", "enum": ["candidates", "transformed"]},
    "emit": {"type": "boolean"},
    "operator": {"type": "string", "enum": ["fix", "specialize", "recurse"]}
   }
  }}
 }
}
